PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/batterapp
JWT_SECRET=replace-with-a-strong-secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret

# MSG91 OTP
MSG91_AUTH_KEY=replace-with-msg91-authkey
MSG91_TEMPLATE_ID=replace-with-msg91-template-id
OTP_RESEND_COOLDOWN_MS=60000
OTP_RATE_WINDOW_MS=900000
OTP_MAX_SEND_PER_WINDOW=5

# Optional services
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CRON_TIMEZONE=Asia/Kolkata

# Checkout pricing (optional)
CHECKOUT_TAX_RATE=0.05
DELIVERY_CHARGE=25
FREE_DELIVERY_MIN=300

# Admin bootstrap (set only when intentionally creating first admin)
ADMIN_REGISTRATION_SECRET=